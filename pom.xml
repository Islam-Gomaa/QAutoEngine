<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tech.wakeb</groupId>
    <artifactId>qa-engine-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>QA Engine</name>

    <modules>
        <module>qa-bom</module>
        <module>qa-core</module>
        <module>qa-contracts</module>
        <module>qa-fixtures</module>
        <module>qa-exec-web</module>
        <module>qa-worker</module>
        <module>qa-dashboard</module>
        <module>qa-platform</module>
        <module>legacy-prototype</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>6.0.3</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <archunit.version>1.4.2</archunit.version>
        <jacoco.version>0.8.16</jacoco.version>
        <surefire.version>3.5.6</surefire.version>
        <enforcer.version>3.7.0</enforcer.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-baseline</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireSameVersions>
                                    <dependencies><dependency>org.seleniumhq.selenium:selenium-*</dependency></dependencies>
                                </requireSameVersions>
                                <requireSameVersions>
                                    <dependencies><dependency>io.qameta.allure:allure-*</dependency></dependencies>
                                </requireSameVersions>
                                <requireJavaVersion><version>[25,)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9.0,)</version></requireMavenVersion>
                                <!-- ADR-026: a mixed Selenium or Allure tree is the audited failure. -->
                                <dependencyConvergence>
                                    <includes>
                                        <include>org.seleniumhq.selenium</include>
                                        <include>io.qameta.allure</include>
                                    </includes>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
