{
  "openapi": "3.0.3",
  "info": {"title": "Fixture API", "version": "1.0.0"},
  "servers": [{"url": "http://blocked.invalid/should-be-ignored"}],
  "components": {
    "securitySchemes": {"bearer": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
      "Item": {"type": "object", "required": ["id", "name", "price"], "additionalProperties": false,
        "properties": {"id": {"type": "integer"}, "name": {"type": "string"}, "price": {"type": "number"}}},
      "ItemList": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Item"}}}},
      "Order": {"type": "object", "required": ["id", "total"], "properties": {"id": {"type": "integer"}, "total": {"type": "number"}}},
      "Status": {"type": "object", "required": ["ok"], "properties": {"ok": {"type": "boolean"}}},
      "Me": {"type": "object", "required": ["user"], "properties": {"user": {"type": "string"}}}
    }
  },
  "paths": {
    "/api/v1/items": {
      "get": {"operationId": "listItems",
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "example": 5}}],
        "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}},
                      "400": {"description": "bad", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "post": {"operationId": "createItem", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}},
        "responses": {"201": {"description": "created"}}}
    },
    "/api/v1/items/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1, "example": 1}}],
      "get": {"operationId": "getItem",
        "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Item"}}}},
                      "400": {"description": "bad", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
                      "404": {"description": "none", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}},
      "delete": {"operationId": "deleteItem", "responses": {"204": {"description": "gone"}}},
      "put": {"operationId": "replaceItem", "responses": {"200": {"description": "ok"}}}
    },
    "/api/v1/items/purge": {"get": {"operationId": "purgeItems", "responses": {"200": {"description": "destructive GET, documented"}}}},
    "/api/v1/search": {"get": {"operationId": "search",
      "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 64, "example": "red"}}],
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}},
                    "400": {"description": "bad", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}},
    "/api/v1/search-read": {"post": {"operationId": "searchRead", "x-read-only": true,
      "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"term": {"type": "string", "example": "red"}}}}}},
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ItemList"}}}}}}},
    "/api/v1/orders/{id}": {"get": {"operationId": "getOrder",
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1, "example": 7}}],
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Order"}}}},
                    "400": {"description": "bad"}}}},
    "/api/v1/status": {"get": {"operationId": "status",
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}}}}},
    "/api/v1/reports/{id}": {"get": {"operationId": "getReport",
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1, "example": 3}}],
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
                    "400": {"description": "bad"}}}},
    "/api/v1/me": {"get": {"operationId": "me", "security": [{"bearer": []}],
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Me"}}}},
                    "401": {"description": "no"}}}},
    "/api/v1/admin/report": {"get": {"operationId": "adminReport", "security": [{"bearer": []}], "x-requires-role": "admin",
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
                    "401": {"description": "no"}, "403": {"description": "no"}}}},
    "/api/v1/admin/users": {"get": {"operationId": "adminUsers", "security": [{"bearer": []}], "x-requires-role": "admin",
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
                    "401": {"description": "no"}, "403": {"description": "no"}}}},
    "/api/v1/admin/audit": {"get": {"operationId": "adminAudit", "security": [{"bearer": []}], "x-requires-role": "admin",
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
                    "401": {"description": "no"}, "403": {"description": "no"}}}},
    "/api/v1/limits": {"get": {"operationId": "limits",
      "parameters": [{"name": "n", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1, "maximum": 10, "example": 2}}],
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
                    "400": {"description": "bad"}}}},
    "/api/v1/debug": {"get": {"operationId": "debug",
      "parameters": [{"name": "mode", "in": "query", "required": true, "schema": {"type": "string", "enum": ["a", "b"]}}],
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}},
                    "400": {"description": "bad"}}}},
    "/api/v1/slow": {"get": {"operationId": "slow",
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}}}}},
    "/api/v1/public": {"get": {"operationId": "publicInfo",
      "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}}}}},
    "/api/v1/moved": {"get": {"operationId": "moved", "responses": {"302": {"description": "redirects to another host"}}}}
  }
}
